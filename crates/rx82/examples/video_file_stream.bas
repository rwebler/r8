10 REM NATIVE BASIC ONLY: STREAM RAW PICTURE FILE INTO FF33
20 F$="crates/rx82/examples/video_picture.bin"
30 POKE 65300,0
40 FOR I=1 TO LEN(F$)
50 POKE 65298,ASC(MID$(F$,I,1))
60 NEXT I
70 POKE 65296,1
80 IF PEEK(65297)/128=1 THEN 200
90 SCREEN 1
100 POKE 65329,0
110 POKE 65330,0
120 FOR I=0 TO 3839
130 B=PEEK(65299)
140 POKE 65331,B
150 NEXT I
160 POKE 65296,3
170 PRINT "FILE-PORT PICTURE LOADED"
180 PRINT "PRESS ENTER TO CLOSE THE WINDOW"
190 INPUT A$
195 END
200 PRINT "FILE OPEN FAILED"
