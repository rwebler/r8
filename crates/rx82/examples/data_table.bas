10 REM LOAD A TABLE FROM DATA THEN REREAD A NAMED SECTION
20 DIM A(11)
30 READ T$
40 FOR I=0 TO LEN(A)-1
50 READ A(I)
60 NEXT I
70 PRINT T$
80 S=0
90 FOR I=0 TO LEN(A)-1
100 S=S+A(I)
110 NEXT I
120 PRINT "Count: ";LEN(A)
130 PRINT "Total: ";S
140 RESTORE 400
150 READ N$,V
160 PRINT N$;": ";V
170 END
300 DATA "Monthly units"
310 DATA 12,15,18,20,22,25
320 DATA 28,27,24,21,17,14
400 DATA Target,240
