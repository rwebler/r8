10 REM BUBBLE SORT WITH AN INTEGER ARRAY
20 DIM A(5)
30 A(0)=9
40 A(1)=2
50 A(2)=7
60 A(3)=1
70 A(4)=5
80 A(5)=3
90 FOR I=0 TO 4
100 FOR J=0 TO 4-I
110 IF A(J)>A(J+1) THEN GOSUB 200
120 NEXT J
130 NEXT I
140 FOR I=0 TO 5
150 PRINT A(I)
160 NEXT I
170 END
200 T=A(J)
210 A(J)=A(J+1)
220 A(J+1)=T
230 RETURN
