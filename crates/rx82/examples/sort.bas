10 REM BUBBLE SORT WITH AN INTEGER ARRAY
20 DIM A(5)
30 FOR I=0 TO LEN(A)-1
40 READ A(I)
50 NEXT I
90 FOR I=0 TO LEN(A)-2
100 FOR J=0 TO LEN(A)-2-I
110 IF A(J)>A(J+1) THEN GOSUB 200
120 NEXT J
130 NEXT I
140 FOR I=0 TO LEN(A)-1
150 PRINT A(I)
160 NEXT I
170 END
200 T=A(J)
210 A(J)=A(J+1)
220 A(J+1)=T
230 RETURN
300 DATA 9,2,7,1,5,3
